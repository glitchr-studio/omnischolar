# The sources' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnischolar sources` says what is installed and configured.

# Where the sources' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNISCHOLAR_PLUGINS=../..

# The contact address the polite APIs ask for (OpenAlex, Crossref, Open
# Library, arXiv, INSPIRE): sent as mailto and in the User-Agent.
OMNISCHOLAR_MAILTO=support@glitchr.io

# OpenAlex: no key needed; a free one (openalex.org/settings/api) raises the
# daily budget tenfold.
OPENALEX_API_KEY=

# HAL: domains every HAL query is filtered on, comma-separated (shs.droit for
# legal scholarship); empty, none. The "droit" source is HAL on shs.droit.
HAL_DOMAINS=
